(
    start_gold: 300,
    // Lineage A's cap. Only read when lose_rule is `overrun`; see `lose_rule`.
    overrun_cap: 150,
    // How the match is lost (`sim-005`, D19). The shipped board is a Lineage B
    // map -- its own script counts "chances" down to zero as creeps reach the
    // goal -- so `lives` is the default and `overrun` is the other lineage
    // available. See the lineage section in tasks/README.org.
    lose_rule: lives,
    // Lineage B's lives, read out of that board rather than invented: its
    // `InitGlobals` sets the chances counter to 60, and the map is advertised
    // as 60 waves. (tune)
    starting_lives: 60,
    wave_interval: 20.0,
    first_wave_delay: 3.0,
    call_wave_cooldown: 5.0,
    // Fraction of a tower's spend returned when it is sold, as a whole percent
    // (D18). Integer so the refund is exact.
    sell_refund_percent: 70,
    // The match's RNG seed (found-009). Every match on these tables is the
    // same match until `lobby-003` lets a host pick one; the command line
    // cannot set it because it is a property of the match, not of the process.
    // (tune)
    seed: 0,
)
